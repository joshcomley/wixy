pxl 1
name owl-perched
size 32x32
maxcolors 14
palette
  k #0e1121 outline
  p #0f1a3d eye-pupil
  1 #1b2536 body-0
  2 #2b3a4c body-1
  3 #445868 body-2
  4 #6a7f88 body-3
  5 #9fb2b0 body-4
  y #4fa3dc eye
  Y #d8f3ff highlight
  b #9a8670 beak
  B #5e5048 beak-dark
  r #b98593 blush
  ramp body = 1 2 3 4 5
  ramp beak = B b
end
anchor eye-l 10,10
anchor eye-r 20,10
anchor foot-l 12,29
anchor foot-r 19,29
# lint-justified: jaggies at 6,5 is where the ear tuft meets the flat head top
# (a corner, not a line)
frame front ms=1200
