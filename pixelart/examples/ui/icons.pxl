pxl 1
name ui-icons
size 16x16
maxcolors 16
tag ui
tag icon
# lint-justified: the remaining 'jaggies' are deliberate corners (heart lobes, the star's
# five inner corners, the moon's horns, the chat bubble's rounded corners and tail), not
# lines.
# One frame per icon, drawn side by side so they share weight, outline and light
# (upper left), per GUIDE.md section 10.
palette
  k #1a1c2c outline
  w #f4f4f4 highlight
  P #f7a1b0 heart-light
  r #e04a5f heart
  R #a8304a heart-dark
  y #ffcd4a star
  Y #c9862b star-dark
  b #6fb7e6 blue-light
  B #3b7dc0 blue
  D #25528a blue-dark
  g #c3ccd2 metal-light
  G #7f8c96 metal
  H #4c5863 metal-dark
  ramp heart = R r P w
  ramp star = Y y w
  ramp blue = D B b w
  ramp metal = H G g w
end
frame heart ms=500
