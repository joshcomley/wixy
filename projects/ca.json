{
  "slug": "ca",
  "name": "Cottage Aesthetics",
  "repo": "https://github.com/joshcomley/cottage-aesthetics-preview.git",
  "defaultBranch": "main",
  "cmdProject": "cottage-aesthetics-preview",
  "domain": "ca.cinnamons.uk",
  "locale": "en-GB",
  "indexable": false,
  "media": { "maxLongSidePx": 2000, "jpegQuality": 85 },
  "adminSections": [
    {
      "id": "before-after",
      "navLabel": "Before & After",
      "title": "Before & After",
      "description": "The photos on your Before & After page. Drag to reorder — changes go live when you press Publish.",
      "page": "gallery",
      "collections": [
        {
          "path": "gallery.categories",
          "label": "Category names",
          "itemNoun": "category",
          "schema": "gallery-category",
          "tab": "Categories",
          "fields": [
            {
              "key": "value",
              "kind": "text",
              "label": "Internal key (short, e.g. \"lips\") — avoid changing this once photos use it",
              "required": true
            },
            { "key": "label", "kind": "text", "label": "Display name shown on your site", "required": true }
          ]
        },
        {
          "path": "gallery.sliders",
          "label": "Drag-to-compare photos",
          "itemNoun": "photo pair",
          "schema": "gallery-slider",
          "alignAspect": "640:360",
          "tab": "Photos",
          "fields": [
            { "key": "before", "kind": "image", "label": "Before photo" },
            { "key": "after", "kind": "image", "label": "After photo" },
            { "key": "title", "kind": "text", "label": "Treatment name", "required": true },
            { "key": "sub", "kind": "text", "label": "Treatment type" },
            { "key": "cat", "kind": "choice", "label": "Category", "optionsFrom": "gallery.categories" },
            { "key": "sourceUrl", "kind": "url", "label": "Original post link (optional)" },
            { "key": "visible", "kind": "toggle", "label": "Show on site" }
          ]
        },
        {
          "path": "gallery.tiles",
          "label": "Tap-to-zoom photos",
          "itemNoun": "photo",
          "schema": "gallery-tile",
          "tab": "Photos",
          "fields": [
            { "key": "img", "kind": "image", "label": "Photo" },
            { "key": "title", "kind": "text", "label": "Caption", "required": true },
            { "key": "cat", "kind": "choice", "label": "Category", "optionsFrom": "gallery.categories" },
            { "key": "visible", "kind": "toggle", "label": "Show on site" }
          ]
        }
      ]
    }
  ]
}
